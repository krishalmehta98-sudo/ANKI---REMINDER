{
  "expo": {
    "name": "Anki Reminder",
    "slug": "anki-reminder",
    "owner": "krish89",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F0F0F",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0F0F"
    },
    "android": {
      "package": "com.krish89.ankireminder",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4FC3DC"
      },
      "permissions": ["RECORD_AUDIO", "CAMERA", "VIBRATE"]
    },
    "ios": {
      "bundleIdentifier": "com.krish89.ankireminder",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Record voice reminders.",
        "NSCameraUsageDescription": "Scan prescriptions and reports."
      }
    }
  }
}
