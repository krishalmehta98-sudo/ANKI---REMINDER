{
  "expo": {
    "name": "Anki Reminder",
    "slug": "anki-reminder",
    "owner": "krish89",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F0F0F",
    "plugins": ["expo-notifications"],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0F0F"
    },
    "android": {
      "package": "com.krish89.ankireminder",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4FC3DC"
      },
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED",
        "FOREGROUND_SERVICE"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.krish89.ankireminder",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Record voice reminders.",
        "NSCameraUsageDescription": "Scan prescriptions and reports."
      }
    },
    "extra": {
      "eas": {
        "projectId": "f2afc482-9264-4843-845e-48cbab308a52"
      }
    }
  }
}
